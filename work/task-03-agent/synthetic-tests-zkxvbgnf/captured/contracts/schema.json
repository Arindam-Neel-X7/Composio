{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One app research record, v1.1",
  "description": "Shape and local evidence requirements only (v1.1 adds vendor_approval_required distinct from partner_approval_required). Reference integrity, truth, scope and run immutability need runtime/reviewer checks in docs/evidence-rules.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run","identity","purpose","auth","credential_eligibility","api_surface","mcp","buildability","conflicts","fetches","review"],
  "properties": {"schema_version":{"const":"1.1"},"run":{"$ref":"#/$defs/run"},"identity":{"type":"object","additionalProperties":false,"required":["id","app","category","roster_ref","resolution"],"properties":{"id":{"type":"integer","minimum":1,"maximum":100},"app":{"type":"string","minLength":1},"category":{"type":"string","minLength":1},"roster_ref":{"const":"data/apps.json"},"resolution":{"$ref":"#/$defs/textClaim"}}},"purpose":{"$ref":"#/$defs/lineClaim"},"auth":{"$ref":"#/$defs/authCollection"},"credential_eligibility":{"type":"object","additionalProperties":false,"required":["testing","production"],"properties":{"testing":{"$ref":"#/$defs/eligibility"},"production":{"$ref":"#/$defs/eligibility"}}},"api_surface":{"$ref":"#/$defs/apiSurface"},"mcp":{"type":"object","additionalProperties":false,"required":["discovery","entries"],"properties":{"discovery":{"$ref":"#/$defs/mcpDiscoveryClaim"},"entries":{"type":"array","items":{"$ref":"#/$defs/mcpEntryClaim"}}},"allOf":[{"if":{"properties":{"discovery":{"properties":{"status":{"enum":["observed","inferred"]}}}}},"then":{"properties":{"entries":{"minItems":1}}}}]},"buildability":{"$ref":"#/$defs/buildClaim"},"conflicts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["claim_refs","description","detected_on"],"properties":{"claim_refs":{"type":"array","items":{"type":"string","minLength":1},"minItems":2},"description":{"type":"string","minLength":1},"detected_on":{"type":"string","format":"date"}}},"minItems":0},"fetches":{"type":"array","items":{"$ref":"#/$defs/fetch"},"minItems":0},"review":{"$ref":"#/$defs/review"}},
  "$defs": {
    "evidence": {"type":"object","additionalProperties":false,"required":["source_url","source_kind","locator","observation","captured_on","capture_method","content_sha256","snapshot_ref","hash_unavailable_reason","document_version","document_date"],"properties":{"source_url":{"type":["string","null"],"format":"uri","pattern":"^https?://"},"source_kind":{"enum":["primary_docs","official_repository","official_product_page","community_repository","community_docs","assignment","execution_receipt"]},"locator":{"type":"string","minLength":1},"observation":{"type":"string","minLength":1},"captured_on":{"type":"string","format":"date"},"capture_method":{"enum":["http_content","browser_content","connected_tool_content","local_snapshot","assignment_text","execution_log"]},"content_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"snapshot_ref":{"type":["string","null"],"minLength":1},"hash_unavailable_reason":{"type":["string","null"],"minLength":1},"document_version":{"type":["string","null"],"minLength":1},"document_date":{"type":["string","null"],"format":"date"}},"allOf":[{"if":{"properties":{"content_sha256":{"type":"null"}}},"then":{"properties":{"hash_unavailable_reason":{"type":"string","minLength":1}}}},{"if":{"properties":{"source_kind":{"const":"execution_receipt"}}},"then":{"properties":{"capture_method":{"const":"execution_log"},"snapshot_ref":{"type":"string","minLength":1},"content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"else":{"properties":{"source_url":{"type":"string"},"capture_method":{"not":{"const":"execution_log"}}}}}]},
    "claim": {"type":"object","additionalProperties":false,"required":["claim_id","status","value","context","evidence","supporting_claim_refs","rationale"],"properties":{"claim_id":{"type":"string","minLength":1},"status":{"enum":["observed","inferred","unknown","disputed","not_researched","not_applicable","not_found_in_checked_sources"]},"value":{},"context":{"type":"string","minLength":1},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"},"minItems":0},"supporting_claim_refs":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"rationale":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"status":{"enum":["observed","inferred"]}}},"then":{"properties":{"value":{"not":{"type":"null"}},"evidence":{"minItems":1}}},"else":{"properties":{"value":{"type":"null"}}}},{"if":{"properties":{"status":{"const":"inferred"}}},"then":{"properties":{"supporting_claim_refs":{"minItems":1}}}},{"if":{"properties":{"status":{"enum":["not_applicable","not_found_in_checked_sources"]}}},"then":{"properties":{"evidence":{"minItems":1}}}},{"if":{"properties":{"status":{"const":"disputed"}}},"then":{"properties":{"evidence":{"minItems":2}}}}]},
    "textClaim": {"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"type":"string","minLength":1}]}}}]},
    "lineClaim": {"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"type":"string","minLength":1,"pattern":"^[^\\r\\n]+$"}]}}}]},
    "booleanClaim": {"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"type":"boolean"}]}}}]},
    "eligibility": {"type":"object","additionalProperties":false,"required":["context","free_access","trial_access","sandbox_access","paid_required","admin_approval_required","vendor_approval_required","partner_approval_required","contact_sales_required","self_serve"],"properties":{"context":{"type":"string","minLength":1},"free_access":{"$ref":"#/$defs/booleanClaim"},"trial_access":{"$ref":"#/$defs/booleanClaim"},"sandbox_access":{"$ref":"#/$defs/booleanClaim"},"paid_required":{"$ref":"#/$defs/booleanClaim"},"admin_approval_required":{"$ref":"#/$defs/booleanClaim"},"vendor_approval_required":{"$ref":"#/$defs/booleanClaim"},"partner_approval_required":{"$ref":"#/$defs/booleanClaim"},"contact_sales_required":{"$ref":"#/$defs/booleanClaim"},"self_serve":{"$ref":"#/$defs/booleanClaim"}}},
    "buildClaim": {"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["verdict","scope","blockers","next_steps"],"properties":{"verdict":{"enum":["build_now","conditional","outreach_required","not_buildable_for_stated_scope"]},"scope":{"type":"string","minLength":1},"blockers":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"next_steps":{"type":"array","items":{"type":"string","minLength":1},"minItems":0}}}]}}},{"properties":{"status":{"enum":["inferred","unknown","disputed","not_researched","not_applicable"]}}}]},
    "run": {"type":"object","additionalProperties":false,"required":["run_id","parent_run_id","created_on","producer","correction_refs","sampling_manifest_ref"],"properties":{"run_id":{"type":"string","minLength":1},"parent_run_id":{"type":["string","null"],"minLength":1},"created_on":{"type":"string","format":"date"},"producer":{"type":"object","additionalProperties":false,"required":["id","type"],"properties":{"id":{"type":"string","minLength":1},"type":{"enum":["ai","human","script"]}}},"correction_refs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["run_id","claim_id","reason"],"properties":{"run_id":{"type":"string","minLength":1},"claim_id":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}},"minItems":0},"sampling_manifest_ref":{"type":["string","null"],"minLength":1}}},
    "fetch": {"type":"object","additionalProperties":false,"required":["source_url","attempted_on","status","http_status","resolved_url","error","content_sha256"],"properties":{"source_url":{"type":"string","format":"uri","pattern":"^https?://"},"attempted_on":{"type":"string","format":"date"},"status":{"enum":["fetched","http_error","dns_error","timeout","blocked","other_error"]},"http_status":{"type":["integer","null"],"minimum":100,"maximum":599},"resolved_url":{"type":["string","null"],"format":"uri"},"error":{"type":["string","null"],"minLength":1},"content_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}}},
    "review": {"type":"object","additionalProperties":false,"required":["status","reviewer","reviewed_on","adjudications"],"properties":{"status":{"enum":["pending","completed"]},"reviewer":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["id","type"],"properties":{"id":{"type":"string","minLength":1},"type":{"enum":["ai","human"]}}}]},"reviewed_on":{"type":["string","null"],"format":"date"},"adjudications":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["claim_id","judgment","reason","evidence","original_run_id"],"properties":{"claim_id":{"type":"string","minLength":1},"judgment":{"enum":["correct","incorrect","unsupported","unresolved","not_applicable"]},"reason":{"type":"string","minLength":1},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"},"minItems":0},"original_run_id":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"judgment":{"const":"unresolved"}}},"then":{"properties":{"evidence":{"minItems":0}}},"else":{"properties":{"evidence":{"minItems":1}}}}]},"minItems":0}},"allOf":[{"if":{"properties":{"status":{"const":"completed"}}},"then":{"properties":{"reviewer":{"type":"object"},"reviewed_on":{"type":"string"},"adjudications":{"minItems":1}}}},{"if":{"properties":{"status":{"const":"pending"}}},"then":{"properties":{"reviewed_on":{"type":"null"},"adjudications":{"maxItems":0}}}}]},
    "authMethodClaim": {"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["method","context","scopes","details"],"properties":{"method":{"enum":["OAuth2","API_key","Basic","Bearer_token","JWT","session_cookie","none","other"]},"context":{"type":"string","minLength":1},"scopes":{"type":"array","items":{"type":"string","minLength":1},"minItems":0},"details":{"type":"string","minLength":1}}}]}}}]},
    "authCollection": {"type":"object","additionalProperties":false,"required":["coverage_status","items","notes"],"properties":{"coverage_status":{"enum":["not_researched","partial","checked_sources"]},"items":{"type":"array","items":{"$ref":"#/$defs/authMethodClaim"}},"notes":{"type":"string","minLength":1}}},
    "protocolClaim": {"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"enum":["REST","GraphQL","RPC","SQL","SDK","CLI","other"]}]}}}]},
    "apiSurface": {"type":"object","additionalProperties":false,"required":["protocols","public_documentation","resource_groups","breadth"],"properties":{"protocols":{"type":"object","additionalProperties":false,"required":["coverage_status","items","notes"],"properties":{"coverage_status":{"enum":["not_researched","partial","checked_sources"]},"items":{"type":"array","items":{"$ref":"#/$defs/protocolClaim"}},"notes":{"type":"string","minLength":1}}},"public_documentation":{"$ref":"#/$defs/booleanClaim"},"resource_groups":{"type":"object","additionalProperties":false,"required":["coverage_status","items","notes"],"properties":{"coverage_status":{"enum":["not_researched","partial","checked_sources"]},"items":{"type":"array","items":{"$ref":"#/$defs/textClaim"}},"notes":{"type":"string","minLength":1}}},"breadth":{"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"enum":["narrow","moderate","broad"]}]}}}]}}},
    "mcpEntryClaim": {"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["origin","name","source_url","repository_url","server_url","scope","operational_check"],"properties":{"origin":{"enum":["official","community"]},"name":{"type":"string","minLength":1},"source_url":{"type":"string","format":"uri","pattern":"^https?://"},"repository_url":{"type":["string","null"],"format":"uri","pattern":"^https?://"},"server_url":{"type":["string","null"],"format":"uri","pattern":"^https?://"},"scope":{"type":"string","minLength":1},"operational_check":{"$ref":"#/$defs/booleanClaim"}}}]}}}]},
    "mcpDiscoveryClaim": {"allOf":[{"$ref":"#/$defs/claim"},{"properties":{"value":{"anyOf":[{"type":"null"},{"const":"found"}]}}}]}
  }
}
